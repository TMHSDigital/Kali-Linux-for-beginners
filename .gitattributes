# Normalize line endings. Text files are stored as LF in the repo.
* text=auto eol=lf

# Executable scripts MUST stay LF (a CRLF shebang breaks them on Linux/macOS).
*.sh   text eol=lf
*.py   text eol=lf

# Web assets: LF.
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# Binary assets should never be line-ending converted.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pcap binary
*.pcapng binary
*.cap  binary
