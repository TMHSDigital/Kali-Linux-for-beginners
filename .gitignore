# ---------------------------------------------------------------------------
# Packet captures & wireless artifacts (can be large and may contain secrets)
# ---------------------------------------------------------------------------
*.pcap
*.pcapng
*.cap
*.cap.gz
*.hccapx
*.hc22000
*.ivs
*.netxml
*.kismet
*.kismet.csv
replay_*.cap
*-01.cap
*-01.csv
*-01.kismet.csv
*-01.kismet.netxml
*-01.log.csv

# ---------------------------------------------------------------------------
# Recon output / scan logs
# ---------------------------------------------------------------------------
*.nmap
*.gnmap
# nmap -oX / -oA output; the parser's test fixtures are the only XML we ship
*.xml
!tests/fixtures/*.xml
scans/
scan-logs/
loot/
recon/
*.xml.bak

# ---------------------------------------------------------------------------
# Cracking output and credentials (never commit recovered or real secrets)
# ---------------------------------------------------------------------------
*.potfile
*.pot
*.22000
*.hash
*.ovpn
*.kdbx
*.pem
*.key
id_rsa*
id_ed25519*

# ---------------------------------------------------------------------------
# Wordlists (huge; ship your own, don't commit them)
# ---------------------------------------------------------------------------
*.txt
rockyou*
wordlists/
!README.txt
!requirements*.txt
!**/lab-notes.txt

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# ---------------------------------------------------------------------------
# Editor / OS cruft
# ---------------------------------------------------------------------------
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Docs site build artifacts (generated by scripts/build-site.py / CI)
# ---------------------------------------------------------------------------
_site/
.jekyll-cache/
node_modules/
.playwright-mcp/

# ---------------------------------------------------------------------------
# Lab runtime data (generated by docker-compose)
# ---------------------------------------------------------------------------
.lab/

# Attacker-container scratch dir (mounted at /root/work)
workspace/*
!workspace/.gitkeep

# ---------------------------------------------------------------------------
# Local environment overrides
# ---------------------------------------------------------------------------
.env
.env.local
*.local

# Personal assistant/tooling instructions and settings (Claude Code loads them; never commit)
CLAUDE.local.md
.claude/settings.local.json
